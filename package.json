{
  "name": "viteval-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Next generation LLM evaluation framework powered by Vitest.",
  "imports": {
    "#docs/*": "./docs/visuals/*.tsx"
  },
  "scripts": {
    "build": "turbo run build --filter='./packages/*'",
    "docs:build": "ciderpress build && node --test scripts/github-stars.test.mjs",
    "docs:dev": "ciderpress dev",
    "docs:preview": "ciderpress serve",
    "docs:check": "ciderpress check",
    "docs:types": "tsc --project docs/visuals/tsconfig.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "check": "pnpm lint && pnpm format",
    "dev": "turbo run dev --filter='./packages/*'",
    "dev:ui": "./scripts/dev-ui.sh",
    "fix": "pnpm lint:fix && pnpm format:fix",
    "gen": "turbo gen",
    "nuke": "nuka-code",
    "publish": "pnpm run build && pnpm changeset publish",
    "sp": "syncpack",
    "test": "turbo run test --filter='./packages/*'",
    "test:coverage": "turbo run test --force --filter='./packages/*' -- --coverage && node scripts/merge-integration-coverage.mjs",
    "types": "turbo run types",
    "validate": "pnpm check && turbo run types test build --filter='./packages/*'",
    "validate:consumer": "turbo run build --filter='./packages/*' --output-logs=errors-only && node scripts/validate-consumer.mjs",
    "validate:browser": "turbo run build --filter='./packages/*' --output-logs=errors-only && node scripts/validate-browser.mjs",
    "types:packages": "turbo run types --filter='./packages/*'",
    "types:examples": "turbo run types --filter='./examples/*'",
    "version": "pnpm changeset version && pnpm install --no-frozen-lockfile"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@ciderpress/theme": "1.0.0-rc.8",
    "@ciderpress/ui": "1.0.0-rc.17",
    "@tsconfig/node24": "^24.0.5",
    "@turbo/gen": "^2.11.7",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "ciderpress": "1.0.0-rc.17",
    "nuka-code": "^0.1.13",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "syncpack": "^15.3.3",
    "tsdown": "^0.23.0",
    "turbo": "^2.11.7",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.x",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.11.2"
}
