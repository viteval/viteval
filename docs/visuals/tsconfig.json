{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@ciderpress/internal/user-config": ["../../ciderpress.config.ts"]
    }
  },
  "include": ["../../ciderpress.config.ts", "./**/*.tsx"]
}
