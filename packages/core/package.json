{
  "name": "@viteval/core",
  "version": "1.0.0-rc.5",
  "description": "Core - Next generation LLM evaluation framework powered by Vitest.",
  "homepage": "https://github.com/viteval/viteval#readme",
  "bugs": "https://github.com/viteval/viteval/issues",
  "repository": "viteval/viteval",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "dist/main/index.mjs",
  "types": "dist/main/index.d.mts",
  "exports": {
    "./internal/execution": {
      "types": "./dist/config/execution.d.mts",
      "import": "./dist/config/execution.mjs"
    },
    "./internal/setup": {
      "types": "./dist/config/setup.d.mts",
      "import": "./dist/config/setup.mjs"
    },
    "./internal/runner": {
      "types": "./dist/config/runner.d.mts",
      "import": "./dist/config/runner.mjs"
    },
    "./internal/reporter": {
      "types": "./dist/reporters/json.d.mts",
      "import": "./dist/reporters/json.mjs"
    },
    "./provider": {
      "types": "./dist/provider/index.d.mts",
      "import": "./dist/provider/index.mjs"
    },
    ".": {
      "types": "./dist/main/index.d.mts",
      "import": "./dist/main/index.mjs"
    },
    "./config": {
      "types": "./dist/config/index.d.mts",
      "import": "./dist/config/index.mjs"
    },
    "./dataset": {
      "types": "./dist/dataset/index.d.mts",
      "import": "./dist/dataset/index.mjs"
    },
    "./reporters": {
      "types": "./dist/reporters/index.d.mts",
      "import": "./dist/reporters/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --typecheck",
    "types": "tsc --noEmit --project tsconfig.build.json"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "@viteval/internal": "workspace:^",
    "ai": "^7.0.137",
    "ajv": "^8.20.0",
    "compute-cosine-similarity": "^1.1.0",
    "human-id": "^4.2.2",
    "js-levenshtein": "^1.1.6",
    "js-yaml": "^5.4.3",
    "linear-sum-assignment": "^1.0.9",
    "massaman": "^0.5.5",
    "mustache": "^4.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/js-levenshtein": "^1.1.3",
    "@types/js-yaml": "^4.0.9",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.7",
    "tsdown": "^0.23.0",
    "type-fest": "^5.10.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
