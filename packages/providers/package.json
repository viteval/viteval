{
  "name": "@viteval/providers",
  "version": "1.0.0-rc.0",
  "description": "JSON, SQLite, and third-party evaluation providers for Viteval.",
  "homepage": "https://github.com/viteval/viteval#readme",
  "bugs": "https://github.com/viteval/viteval/issues",
  "license": "MIT",
  "repository": "viteval/viteval",
  "files": [
    "dist",
    "prisma"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./viteval": {
      "types": "./dist/viteval.d.mts",
      "import": "./dist/viteval.mjs"
    },
    "./braintrust": {
      "types": "./dist/braintrust.d.mts",
      "import": "./dist/braintrust.mjs"
    },
    "./langfuse": {
      "types": "./dist/langfuse.d.mts",
      "import": "./dist/langfuse.mjs"
    },
    "./voltops": {
      "types": "./dist/voltops.d.mts",
      "import": "./dist/voltops.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --typecheck",
    "types": "tsc --noEmit",
    "prisma:generate": "prisma7 generate"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "@viteval/core": "workspace:^",
    "@viteval/internal": "workspace:^",
    "massaman": "^0.5.2"
  },
  "devDependencies": {
    "@braintrust/api": "^0.5.0",
    "@langfuse/client": "^5.13.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/prisma7": "^7.10.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@voltagent/sdk": "^2.0.3",
    "better-sqlite3": "^13.0.3",
    "pg": "^8.23.1",
    "prisma": "8.0.0-rc.22",
    "tsdown": "^0.23.0",
    "type-fest": "^5.10.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@braintrust/api": ">=0.5.0",
    "@langfuse/client": "^5.13.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": ">=7.0.0",
    "@prisma/client": "^7.10.0",
    "@voltagent/sdk": "^2.0.3",
    "better-sqlite3": "^13.0.3",
    "pg": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@langfuse/client": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    },
    "@voltagent/sdk": {
      "optional": true
    },
    "@prisma/adapter-better-sqlite3": {
      "optional": true
    },
    "@prisma/client": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "@braintrust/api": {
      "optional": true
    },
    "@prisma/adapter-pg": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
