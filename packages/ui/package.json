{
  "name": "@viteval/ui",
  "version": "1.0.0-rc.4",
  "description": "Viteval UI - local UI for viewing the results of your evals",
  "homepage": "https://github.com/viteval/viteval#readme",
  "bugs": "https://github.com/viteval/viteval/issues",
  "license": "MIT",
  "repository": "viteval/viteval",
  "files": [
    "dist/client",
    "dist/server",
    "production-server.mjs",
    "production-server.mjs.map",
    "server.d.mts",
    "server.mjs",
    "server.mjs.map"
  ],
  "type": "module",
  "main": "server.mjs",
  "module": "server.mjs",
  "types": "server.d.mts",
  "exports": {
    ".": {
      "types": "./server.d.mts",
      "import": "./server.mjs"
    }
  },
  "scripts": {
    "test": "vitest run",
    "build": "pnpm build:ui && pnpm build:server",
    "build:server": "tsdown",
    "build:ui": "vite build",
    "dev": "vite --port 6274",
    "start": "node production-server.mjs",
    "types": "pnpm tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@iconify/react": "^6.0.2",
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-start": "^1.168.61",
    "@tanstack/react-table": "^9.2.8",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@uidotdev/usehooks": "^2.4.1",
    "@viteval/core": "workspace:^",
    "@viteval/internal": "workspace:^",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "get-port": "^7.2.0",
    "hono": "^4.13.13",
    "lodash-es": "^4.18.1",
    "massaman": "^0.5.5",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "recharts": "3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "geist": "^1.7.2",
    "jsdom": "^30.1.2",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
