{
  "name": "@viteval/cli",
  "version": "1.0.0-rc.3",
  "description": "Command line interface for Viteval - Next generation LLM evaluation framework powered by Vitest.",
  "homepage": "https://github.com/viteval/viteval#readme",
  "bugs": "https://github.com/viteval/viteval/issues",
  "repository": "viteval/viteval",
  "bin": {
    "viteval": "cli.mjs"
  },
  "files": [
    "cli.mjs",
    "dist/*.mjs",
    "dist/*.mjs.map"
  ],
  "type": "module",
  "main": "cli.mjs",
  "scripts": {
    "build": "tsdown",
    "build:binary": "node build-binary.ts",
    "dev": "tsdown --watch",
    "test": "vitest run --typecheck --passWithNoTests",
    "test:binary": "pnpm build:binary && node test-binary.ts",
    "types": "tsc --noEmit && tsc --noEmit --project tsconfig.scripts.json"
  },
  "dependencies": {
    "@viteval/core": "workspace:*",
    "@viteval/internal": "workspace:*",
    "@viteval/ui": "workspace:*",
    "consola": "^3.4.2",
    "glob": "^13.0.6",
    "ink": "^8.0.0",
    "maltty": "1.0.0-rc.4",
    "massaman": "^0.5.5",
    "open": "^11.0.4",
    "react": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@maltty/bundler": "1.0.0-rc.4",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
