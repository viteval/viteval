{
  "name": "viteval",
  "version": "1.0.0-rc.6",
  "description": "Next generation LLM evaluation framework powered by Vitest.",
  "keywords": [
    "ai",
    "evaluation",
    "javascript",
    "llm",
    "testing",
    "typescript",
    "vitest"
  ],
  "homepage": "https://github.com/viteval/viteval#readme",
  "bugs": "https://github.com/viteval/viteval/issues",
  "license": "MIT",
  "author": "viteval",
  "repository": "viteval/viteval",
  "bin": {
    "viteval": "./cli.mjs"
  },
  "files": [
    "cli.mjs",
    "dist"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    "./provider": {
      "types": "./dist/provider.d.mts",
      "import": "./dist/provider.mjs"
    },
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs"
    },
    "./dataset": {
      "types": "./dist/dataset.d.mts",
      "import": "./dist/dataset.mjs"
    },
    "./reporters": {
      "types": "./dist/reporters.d.mts",
      "import": "./dist/reporters.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --typecheck --passWithNoTests",
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "@viteval/cli": "workspace:*",
    "@viteval/core": "workspace:*",
    "vitest": "^5.0.3"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
